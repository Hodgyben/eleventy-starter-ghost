# Ghost (see README)
GHOST_API_URL=https://eleventy.ghost.io
GHOST_CONTENT_API_KEY=5a562eebab8528c44e856a3e0a
SITE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Octopus Energy dashboard
# ---------------------------------------------------------------------------
# Copy this file to .env.local (git-ignored) and fill in your own values, or
# set them as environment variables in your host's build settings.
#
# The API key comes from https://octopus.energy/dashboard/new/accounts/personal-details/api-access
# Treat it as a password: it can read your account. Never commit it.

OCTOPUS_API_KEY=
# Optional but recommended — lets the dashboard read your real tariff codes
# (looks like A-AAAA1111 on your bill).
OCTOPUS_ACCOUNT_NUMBER=

OCTOPUS_ELECTRICITY_MPAN=
OCTOPUS_ELECTRICITY_SERIAL=
OCTOPUS_GAS_MPRN=
OCTOPUS_GAS_SERIAL=

# Only needed if you don't set OCTOPUS_ACCOUNT_NUMBER, e.g. E-1R-VAR-22-11-01-A
OCTOPUS_ELECTRICITY_TARIFF_CODE=
OCTOPUS_GAS_TARIFF_CODE=

# SMETS2 gas meters report cubic metres (m3); older SMETS1 meters report kWh.
OCTOPUS_GAS_UNITS=m3
OCTOPUS_GAS_CALORIFIC_VALUE=39.5

# How much history to chart, and how long a build may reuse the cache.
OCTOPUS_HISTORY_DAYS=90
OCTOPUS_CACHE_MAX_AGE_MINUTES=180
